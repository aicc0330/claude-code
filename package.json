{
  "name": "claude-dispatch",
  "version": "1.0.0",
  "description": "Cross-device session dispatch for Claude Code",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "local-api": "ts-node src/local-api-server.ts",
    "plan-a": "npm run build && npm run local-api"
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0",
    "uuid": "^9.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^18.15.0",
    "@types/node-fetch": "^2.6.13",
    "@types/uuid": "^9.0.2",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
